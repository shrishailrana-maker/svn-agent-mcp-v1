    "advancedInputs": {
      "names": {
        "svn_status": [
          "afterCursor",
          "conflictCursor"
        ],
        "svn_snapshot": [
          "afterCursor",
          "conflictCursor"
        ],
        "svn_diff": [
          "file",
          "operationId"
        ],
        "eol_fix_verified": [
          "operationId"
        ],
        "svn_log": [
          "changedPathsSummary",
          "maxTopLevelDirectories",
          "messageContains",
          "messageCaseSensitive",
          "scanLimit"
        ],
        "svn_update": [
          "maxItems",
          "cursor",
          "conflictCursor",
          "taskPaths",
          "targetOverlapOnly",
          "operationId"
        ],
        "svn_commit": [
          "operation",
          "revision",
          "expectedRemoteHead",
          "lineLimit",
          "requireUniformRevision",
          "expandDescendants",
          "allowRoot",
          "allowDirectoryTargets",
          "operationId"
        ],
        "svn_resolve": [
          "operationId"
        ]
      },
      "limits": {
        "afterCursor": "opaque string; max 64 chars",
        "operationId": "UUID",
        "file": "path; max 4096 chars",
        "messageContains": "1..256 chars",
        "scanLimit": "1..500",
        "maxTopLevelDirectories": "1..50",
        "maxItems": "1..500",
        "cursor": "decimal string; max 32 digits",
        "conflictCursor": "decimal string; max 32 digits; conflict pages contain at most 100 items",
        "taskPaths": "1..500 paths; each max 4096 chars"
      }
    }
  },
  "tools": [
    {
      "name": "svn_self_check",
      "description": "Check package and bundled runtime health.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cwd": {
            "description": "Absolute WC directory; required for relative paths.",
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\x00]*$"
          },
          "detailed": {
            "type": "boolean"
          },
          "responseMode": {
            "type": "string",
            "enum": [
              "compact",
              "standard",
              "full",
              "receipt",
              "structured-only"
            ]
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
