    {
      "name": "svn_precommit",
      "description": "Run guarded status, diff, EOL, and revision checks.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cwd": {
            "description": "Absolute WC directory; required for relative paths.",
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\x00]*$"
          },
          "paths": {
            "minItems": 1,
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\x00]*$"
            },
            "description": "One to 500 explicit paths inside one WC."
          },
          "lineLimit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          },
          "includeDiff": {
            "type": "boolean"
          },
          "maxChars": {
            "type": "integer",
            "minimum": 256,
            "maximum": 64000
          },
          "allowRoot": {
            "description": "Acknowledge a working-copy-root commit target.",
            "type": "boolean"
          },
          "allowDirectoryTargets": {
            "description": "Acknowledge that an existing directory target commits only the directory node; descendants require explicit paths.",
            "type": "boolean"
          },
          "expandDescendants": {
            "description": "Expand explicit directory targets to all currently changed descendants, guard every result, and expose the exact scope.",
            "type": "boolean"
          },
          "requireUniformRevision": {
            "description": "Refuse READY while the working copy spans more than one revision; intended for release handoffs.",
            "type": "boolean"
          },
          "responseMode": {
            "type": "string",
            "enum": [
              "compact",
              "standard",
              "full",
              "receipt",
              "structured-only"
            ]
          }
        },
        "required": [
          "paths"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
